# Track distributable skills, essential repository files, and curated eval sources.
/*
!/.gitignore
!/LICENSE
!/README.md
!/skills/
!/references/
!/evaluation/

# Opt evaluation suites in deliberately; keep historical local research ignored.
/evaluation/*
!/evaluation/README.md
!/evaluation/close-bars/
/evaluation/close-bars/results/

# Keep generated files out of runtime folders too.
__pycache__/
.pytest_cache/
.ruff_cache/
.DS_Store
